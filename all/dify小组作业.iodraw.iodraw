mxGeometry x=&quot;470&quot; y=&quot;870&quot; width=&quot;220&quot; height=&quot;50&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;18&quot; value=&quot;引导用户提交本题答案（文本/图片/文件）&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;470&quot; y=&quot;950&quot; width=&quot;220&quot; height=&quot;50&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;19&quot; value=&quot;用户答案解析（同题目解析逻辑）&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;470&quot; y=&quot;1030&quot; width=&quot;220&quot; height=&quot;50&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;20&quot; value=&quot;自动判卷（代码节点）&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;470&quot; y=&quot;1110&quot; width=&quot;220&quot; height=&quot;50&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;21&quot; value=&quot;客观题：精确匹配判分&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=11&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;320&quot; y=&quot;1190&quot; width=&quot;200&quot; height=&quot;45&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;22&quot; value=&quot;主观题：语义相似度+关键词判分&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=11&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;560&quot; y=&quot;1190&quot; width=&quot;200&quot; height=&quot;45&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;23&quot; value=&quot;判卷置信度是否达标？&quot; style=&quot;rhombus;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f57c00;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;480&quot; y=&quot;1260&quot; width=&quot;200&quot; height=&quot;70&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;24&quot; value=&quot;保存单题判分结果&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;800&quot; y=&quot;1260&quot; width=&quot;220&quot; height=&quot;50&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;25&quot; value=&quot;所有题目处理完毕？&quot; style=&quot;rhombus;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f57c00;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;810&quot; y=&quot;1340&quot; width=&quot;200&quot; height=&quot;70&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;!-- 报告生成与结束 --&amp;gt;&#xa;        &amp;lt;mxCell id=&quot;26&quot; value=&quot;生成完整判卷报告&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;470&quot; y=&quot;1440&quot; width=&quot;220&quot; height=&quot;50&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;27&quot; value=&quot;展示报告：总分+单题详情+错误原因+建议&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;470&quot; y=&quot;1520&quot; width=&quot;220&quot; height=&quot;50&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;28&quot; value=&quot;是否需要人工复核？&quot; style=&quot;rhombus;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f57c00;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;480&quot; y=&quot;1600&quot; width=&quot;200&quot; height=&quot;70&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;29&quot; value=&quot;提交人工审核队列&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#d32f2f;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;150&quot; y=&quot;1600&quot; width=&quot;220&quot; height=&quot;50&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;30&quot; value=&quot;流程结束&quot; style=&quot;ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;500&quot; y=&quot;1700&quot; width=&quot;160&quot; height=&quot;50&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;!-- 连线部分（100%对齐你的流程图） --&amp;gt;&#xa;        &amp;lt;mxCell id=&quot;31&quot; value=&quot;&quot; style=&quot;endArrow=classic;html=1;strokeWidth=2&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;2&quot; target=&quot;3&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry relative