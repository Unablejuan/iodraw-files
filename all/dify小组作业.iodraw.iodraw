        <UserObject label="&lt;span style=&quot;color: rgb(0, 0, 0); font-family: ui-sans-serif, system-ui, sans-serif, &amp;quot;Apple Color Emoji&amp;quot;, &amp;quot;Segoe UI Emoji&amp;quot;, &amp;quot;Segoe UI Symbol&amp;quot;, &amp;quot;Noto Color Emoji&amp;quot;; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: left; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: pre; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; display: inline !important; float: none;&quot;&gt;&amp;lt;mxfile host=&quot;app.diagrams.net&quot; modified=&quot;2026-04-29&quot; agent=&quot;Mozilla/5.0&quot; version=&quot;22.1.16&quot; type=&quot;device&quot;&amp;gt;&#xa;  &amp;lt;diagram id=&quot;dify-exam-final&quot; name=&quot;Dify面试题自动判卷流程（最终修正版）&quot;&amp;gt;&#xa;    &amp;lt;mxGraphModel dx=&quot;1400&quot; dy=&quot;2000&quot; grid=&quot;1&quot; gridSize=&quot;10&quot; guides=&quot;1&quot; tooltips=&quot;1&quot; connect=&quot;1&quot; arrows=&quot;1&quot;&amp;gt;&#xa;      &amp;lt;root&amp;gt;&#xa;        &amp;lt;mxCell id=&quot;0&quot;/&amp;gt;&#xa;        &amp;lt;mxCell id=&quot;1&quot; parent=&quot;0&quot;/&amp;gt;&#xa;        &#xa;        &amp;lt;!-- 开始与输入校验 --&amp;gt;&#xa;        &amp;lt;mxCell id=&quot;2&quot; value=&quot;用户发起判卷任务&quot; style=&quot;ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;500&quot; y=&quot;20&quot; width=&quot;160&quot; height=&quot;50&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;3&quot; value=&quot;引导用户上传：题目文件/图片&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;470&quot; y=&quot;100&quot; width=&quot;220&quot; height=&quot;50&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;4&quot; value=&quot;上传内容校验&quot; style=&quot;rhombus;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f57c00;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;480&quot; y=&quot;180&quot; width=&quot;200&quot; height=&quot;70&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;5&quot; value=&quot;提示错误，返回重新上传&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#d32f2f;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;150&quot; y=&quot;180&quot; width=&quot;220&quot; height=&quot;50&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;6&quot; value=&quot;内容解析&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;470&quot; y=&quot;280&quot; width=&quot;220&quot; height=&quot;50&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;7&quot; value=&quot;文件：Dify文档解析节点&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=11&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;320&quot; y=&quot;360&quot; width=&quot;200&quot; height=&quot;45&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;8&quot; value=&quot;图片：Dify OCR节点&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontSize=11&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;560&quot; y=&quot;360&quot; width=&quot;200&quot; height=&quot;45&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;9&quot; value=&quot;解析是否成功？&quot; style=&quot;rhombus;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f57c00;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;480&quot; y=&quot;430&quot; width=&quot;200&quot; height=&quot;70&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;10&quot; value=&quot;智能拆分单题（代码节点）&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#388e3c;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;470&quot; y=&quot;530&quot; width=&quot;220&quot; height=&quot;50&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;!-- 循环处理核心（完全对齐你的图） --&amp;gt;&#xa;        &amp;lt;mxCell id=&quot;11&quot; value=&quot;逐题处理（循环节点入口）&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=12;strokeWidth=2&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;470&quot; y=&quot;610&quot; width=&quot;220&quot; height=&quot;50&quot; as=&quot;geometry&quot;/&amp;gt;&#xa;        &amp;lt;/mxCell&amp;gt;&#xa;        &#xa;        &amp;lt;mxCell id=&quot;12&quot; value=&quot;知识库检索标准答案&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#0288d1;fontSize=12&quot; vertex=&quot;1&quot; parent=&quot;1&quot;&amp;gt;&#xa;          &amp;lt;mxGeometry x=&quot;470&quot; y=&quot;690&quot; width=&quot;220&quot; height=&quot;50&quot; as=&quot;geome